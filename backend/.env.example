# Database
DATABASE_URL=postgresql://user:password@host:5432/school_management

# JWT Secrets
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key

# CORS — Comma-separated frontend URLs allowed to call this API
# Leave empty or omit to allow all origins (dev mode)
FRONTEND_URL=https://your-app.vercel.app

# Server Port (Render default is 10000)
PORT=5000

# MinIO / Object Storage (optional)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=school-erp

# SMS Gateway (optional)
MSG91_AUTH_KEY=your-msg91-key
MSG91_SENDER_ID=SCHOOL

# Payment Gateway (optional)
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# SMTP Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=school@gmail.com
SMTP_PASS=app-password

# Encryption
ENCRYPTION_KEY=32-char-key-for-aadhaar-encryption
